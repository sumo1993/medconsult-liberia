# Database mode: mysql (default) or postgres
DB_CLIENT=mysql

# MySQL settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medconsult_liberia

# PostgreSQL / Supabase (use when DB_CLIENT=postgres)
# Example:
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
PGSSLMODE=require
DB_POOL_MAX=10

JWT_SECRET=replace_with_a_long_random_secret

# --- Email (password reset, notifications) ---
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — use that 16-character value for SMTP_PASS
# (not your normal Gmail password). Spaces in the app password are ignored by the app.
# NEXT_PUBLIC_APP_URL must match the site URL used in reset links (e.g. http://localhost:3002).
NEXT_PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true only if you use port 465
SMTP_USER=your.account@gmail.com
SMTP_PASS=
# If manual host/port fails, try nodemailer's Gmail preset (default on):
# SMTP_USE_GMAIL_SERVICE=true

# --- Cloudinary (media / file uploads) ---
# Required on Vercel — Vercel has a read-only filesystem so files MUST go to Cloudinary.
# Sign up free at https://cloudinary.com -> copy credentials from the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
