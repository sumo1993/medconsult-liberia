# Database mode: mysql (default) or postgres
DB_CLIENT=mysql

# MySQL settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medconsult_liberia

# PostgreSQL / Supabase (use when DB_CLIENT=postgres)
# Example:
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
PGSSLMODE=require
DB_POOL_MAX=10

# Supabase (database + file storage — same project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=replace_with_a_long_random_secret

# --- Email (password reset, notifications) ---
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — use that 16-character value for SMTP_PASS
NEXT_PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.account@gmail.com
SMTP_PASS=

# --- Cloudinary (optional — only needed if NOT using Supabase Storage) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
